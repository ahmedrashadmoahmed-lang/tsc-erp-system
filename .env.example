# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tsc_erp?schema=public"

# Authentication
# ⚠️ IMPORTANT: Generate strong secrets for production using:
# openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE-THIS-TO-STRONG-SECRET-IN-PRODUCTION"
NEXTAUTH_URL="http://localhost:3000"

# JWT
# ⚠️ IMPORTANT: Use different secret than NEXTAUTH_SECRET
JWT_SECRET="CHANGE-THIS-TO-DIFFERENT-STRONG-SECRET"

# Egyptian Tax Settings
VAT_RATE=14
PROFIT_TAX_RATE=1

# App Settings
NEXT_PUBLIC_APP_NAME="TSC ERP System"
NEXT_PUBLIC_CURRENCY="EGP"
NEXT_PUBLIC_CURRENCY_SYMBOL="ج.م"

# Logging (optional)
LOG_LEVEL="info"
